@page
@model ChatClient2.Pages.ChatModel
@{
    ViewData["Title"] = "Chat (access-key only)";
}

<h1>Chat with @Model.ModelName</h1>
<p class="text-muted">No sign-in &middot; access-key only: this client &rarr; LiteLLM (master key) &rarr; Microsoft Foundry (managed identity)</p>

<div class="border rounded p-3 mb-3" style="min-height: 300px; max-height: 60vh; overflow-y: auto;" id="conversation">
    @foreach (var turn in Model.Conversation)
    {
        <div class="mb-2">
            <strong>@(turn.Role == "user" ? "You" : Model.ModelName):</strong>
            <span>@turn.Content</span>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post">
    <div class="input-group">
        <input type="text" class="form-control" name="Message" placeholder="Type a message..." required autofocus />
        <button type="submit" class="btn btn-primary">Send</button>
    </div>
</form>
