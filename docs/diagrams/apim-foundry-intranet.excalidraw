      "boundElements": null,
      "updated": 0,
      "link": null,
      "locked": false,
      "x": 66,
      "y": 765,
      "width": 1628,
      "height": 127.5,
      "text": "Client: APIM_NAME.azure-api.net -> APIM PE private IP. Link/forward privatelink.azure-api.net for each client VNet.\nAPIM: normal Foundry FQDN -> Foundry PE IP via its private zones. Permit TCP 443 with approved NSGs/routes.\nThe public APIM gateway remains enabled. A private endpoint does not, by itself, restrict public access.",
      "originalText": "Client: APIM_NAME.azure-api.net -> APIM PE private IP. Link/forward privatelink.azure-api.net for each client VNet.\nAPIM: normal Foundry FQDN -> Foundry PE IP via its private zones. Permit TCP 443 with approved NSGs/routes.\nThe public APIM gateway remains enabled. A private endpoint does not, by itself, restrict public access.",
      "fontSize": 17,
      "fontFamily": 2,
      "lineHeight": 1.4,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
