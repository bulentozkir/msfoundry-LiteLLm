# Copy to terraform.tfvars and fill in with values from the Microsoft Foundry
# project + model deployment (see project/create-foundry-project.md). Do not
# commit terraform.tfvars once it contains a real API key.

subscription_id              = null   # or a specific subscription GUID
location                     = "northcentralus"
resource_group_name          = "rg-litellm-foundry-test"

azure_openai_endpoint         = "https://<your-foundry-account>.openai.azure.com"
azure_openai_deployment_name  = "gpt-5-mini"
azure_openai_api_version      = "2024-10-21"
foundry_account_id            = "/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account-name>"

litellm_model_alias = "gpt-5-mini"

litellm_ui_username = "aiadmin"
litellm_ui_password = ""   # required to log into /ui on either proxy
